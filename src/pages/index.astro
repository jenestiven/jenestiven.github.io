---
import { getCollection } from 'astro:content';
import LabView from '../components/lab/LabView.tsx';
import Layout from '../layouts/Layout.astro';
import type { LabProfile, LabProject } from '../types';

// v2 del portafolio (addendums v8 y v9): un solo mapa, tres lentes, y
// jenestiven.github.io integrado como vista Leer. La v1 vive en /v1.
const projects: LabProject[] = (await getCollection('projects'))
	.map((entry) => entry.data)
	.filter((project) => !project.draft)
	.sort((a, b) => a.order - b.order);

const profileEntry = (await getCollection('profile')).find((entry) => entry.data.id === 'main');
if (!profileEntry) throw new Error('Falta src/content/profile/main.json');
const profile: LabProfile = profileEntry.data;
---

<Layout
	title="Jhon González Aricapa · Topographer, GIS & Software Developer"
	description="Topographer, GIS developer and software developer. One interactive map with three lenses: surveying, geospatial analysis and the software built on top of them. Cali, Colombia."
	lang="en"
>
	<Fragment slot="head">
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		<!--
			Un enlace con hash (#read, #<proyecto>) va directo a su destino: la
			portada se oculta antes del primer pintado para que no parpadee.
		-->
		<script is:inline>
			if (location.hash.length > 1) document.documentElement.classList.add('lab-skip-intro');
			// El HTML llega en inglés. Si la persona prefiere español, la portada
			// espera oculta hasta que la app cambie el idioma, para que no parpadee.
			try {
				var saved = localStorage.getItem('portfolio-lang');
				var spanish = saved ? saved === 'es' : navigator.language.toLowerCase().indexOf('es') === 0;
				if (spanish) document.documentElement.dataset.langPending = 'true';
			} catch (e) {}
		</script>
	</Fragment>
	<div class="fixed inset-0">
		<LabView profile={profile} projects={projects} client:load />
	</div>
</Layout>
